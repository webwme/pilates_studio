<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Serenity Pilates Studio - Find your balance through mindful movement. Book your first class today.">
    <title>Serenity Pilates — Find Your Balance</title>

    <!-- ============================================
         GOOGLE FONTS
         Playfair Display: Elegant serif for headings
         Inter: Clean sans-serif for body text
         ============================================ -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* ============================================
           CSS CUSTOM PROPERTIES (Design Tokens)
           Centralized values for colors, fonts, spacing
           ============================================ */
        :root {
            /* Color palette */
            --color-cream: #FAF7F2;
            --color-cream-dark: #F0E9DD;
            --color-sage: #8B9E82;
            --color-sage-light: #A8B8A0;
            --color-sage-dark: #6B7E62;
            --color-charcoal: #2D2D2D;
            --color-text: #4A4A4A;
            --color-text-light: #7A7A7A;
            --color-white: #FFFFFF;
            --color-border: #E5DDD3;

            /* Typography */
            --font-serif: 'Playfair Display', Georgia, serif;
            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;

            /* Spacing */
            --section-padding: 120px;
            --container-max: 1200px;

            /* Effects */
            --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --shadow-sm: 0 4px 20px rgba(0, 0, 0, 0.04);
            --shadow-md: 0 10px 40px rgba(0, 0, 0, 0.08);
            --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.12);
        }

        /* ============================================
           CSS RESET & BASE STYLES
           Normalize browser defaults
           ============================================ */
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            font-size: 16px;
        }

        body {
            font-family: var(--font-sans);
            color: var(--color-text);
            background-color: var(--color-cream);
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        img, svg {
            max-width: 100%;
            height: auto;
            display: block;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: var(--transition);
        }

        ul {
            list-style: none;
        }

        /* ============================================
           UTILITY CLASSES
           Reusable layout and typography helpers
           ============================================ */
        .container {
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 24px;
        }

        .section {
            padding: var(--section-padding) 0;
        }

        /* Section label - small uppercase text above titles */
        .section-label {
            display: inline-block;
            font-family: var(--font-sans);
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--color-sage);
            margin-bottom: 16px;
        }

        /* Section title - large serif heading */
        .section-title {
            font-family: var(--font-serif);
            font-size: clamp(2.2rem, 5vw, 3.5rem);
            font-weight: 400;
            color: var(--color-charcoal);
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .section-header {
            text-align: center;
            max-width: 640px;
            margin: 0 auto 64px;
        }

        .section-description {
            font-size: 1.05rem;
            color: var(--color-text-light);
            line-height: 1.7;
        }

        /* ============================================
           BUTTONS
           Primary (filled) and outline button variants
           ============================================ */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 16px 36px;
            font-family: var(--font-sans);
            font-size: 0.85rem;
            font-weight: 500;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            border: 2px solid transparent;
            border-radius: 50px;
            cursor: pointer;
            transition: var(--transition);
            white-space: nowrap;
        }

        .btn--primary {
            background-color: var(--color-sage);
            color: var(--color-white);
            border-color: var(--color-sage);
        }

        .btn--primary:hover {
            background-color: var(--color-sage-dark);
            border-color: var(--color-sage-dark);
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(139, 158, 130, 0.35);
        }

        .btn--outline {
            background-color: transparent;
            color: var(--color-charcoal);
            border-color: var(--color-charcoal);
        }

        .btn--outline:hover {
            background-color: var(--color-charcoal);
            color: var(--color-white);
            transform: translateY(-3px);
        }

        .btn--lg {
            padding: 20px 44px;
            font-size: 0.9rem;
        }

        /* ============================================
           NAVIGATION
           Fixed header with logo, links, and CTA
           Uses CSS-only mobile menu via checkbox hack
           ============================================ */
        .header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 22px 0;
            background-color: rgba(250, 247, 242, 0.92);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(229, 221, 211, 0.5);
        }

        .header__container {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Logo: serif brand name + small caps subtitle */
        .header__logo {
            display: flex;
            flex-direction: column;
            line-height: 1;
        }

        .header__logo-text {
            font-family: var(--font-serif);
            font-size: 1.8rem;
            font-weight: 400;
            color: var(--color-charcoal);
        }

        .header__logo-sub {
            font-family: var(--font-sans);
            font-size: 0.6rem;
            font-weight: 600;
            letter-spacing: 4px;
            color: var(--color-sage);
            margin-top: 2px;
        }

        .nav__list {
            display: flex;
            gap: 40px;
        }

        .nav__link {
            font-size: 0.88rem;
            font-weight: 500;
            color: var(--color-text);
            position: relative;
            padding: 6px 0;
        }

        /* Animated underline on hover */
        .nav__link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 1.5px;
            background-color: var(--color-sage);
            transition: var(--transition);
        }

        .nav__link:hover::after {
            width: 100%;
        }

        .header__cta {
            padding: 11px 26px;
            font-size: 0.8rem;
        }

        /* Mobile menu toggle - hidden checkbox + label */
        .nav__toggle {
            display: none;
        }

        .nav__burger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            padding: 8px;
            z-index: 1001;
        }

        .nav__burger span {
            display: block;
            width: 24px;
            height: 2px;
            background-color: var(--color-charcoal);
            transition: var(--transition);
        }

        /* ============================================
           HERO SECTION
           Full-viewport intro with gradient background,
           large serif title, and CTA buttons
           ============================================ */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding-top: 80px;
            overflow: hidden;
        }

        /* Decorative gradient background */
        .hero__background {
            position: absolute;
            inset: 0;
            background: 
                radial-gradient(circle at 85% 20%, rgba(139, 158, 130, 0.15) 0%, transparent 45%),
                radial-gradient(circle at 15% 80%, rgba(168, 184, 160, 0.12) 0%, transparent 50%),
                linear-gradient(135deg, #F5EFE6 0%, #EDE4D6 100%);
            z-index: 0;
        }

        /* Decorative SVG illustration in hero */
        .hero__illustration {
            position: absolute;
            right: 5%;
            top: 50%;
            transform: translateY(-50%);
            width: 45%;
            max-width: 550px;
            opacity: 0.9;
            z-index: 1;
        }

        .hero__container {
            position: relative;
            z-index: 2;
            width: 100%;
        }

        .hero__content {
            max-width: 600px;
        }

        .hero__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--color-sage);
            margin-bottom: 28px;
        }

        .hero__eyebrow::before {
            content: '';
            width: 40px;
            height: 1px;
            background-color: var(--color-sage);
        }

        .hero__title {
            font-family: var(--font-serif);
            font-size: clamp(2.8rem, 7vw, 5rem);
            font-weight: 400;
            color: var(--color-charcoal);
            line-height: 1.05;
            margin-bottom: 28px;
            letter-spacing: -0.5px;
        }

        .hero__title em {
            font-style: italic;
            color: var(--color-sage-dark);
        }

        .hero__subtitle {
            font-size: 1.15rem;
            color: var(--color-text-light);
            line-height: 1.7;
            margin-bottom: 44px;
            max-width: 480px;
        }

        .hero__actions {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 60px;
        }

        /* Stats row at bottom of hero */
        .hero__stats {
            display: flex;
            gap: 48px;
            padding-top: 40px;
            border-top: 1px solid var(--color-border);
        }

        .hero__stat-number {
            display: block;
            font-family: var(--font-serif);
            font-size: 2.2rem;
            color: var(--color-charcoal);
            line-height: 1;
            margin-bottom: 6px;
        }

        .hero__stat-label {
            font-size: 0.8rem;
            color: var(--color-text-light);
            letter-spacing: 0.5px;
        }

        /* ============================================
           ABOUT SECTION
           Two-column layout: image (SVG) + text
           ============================================ */
        .about {
            background-color: var(--color-white);
        }

        .about__container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
        }

        .about__image {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            aspect-ratio: 4 / 5;
            background: linear-gradient(135deg, #E8E0D4 0%, #D4C9BC 100%);
            box-shadow: var(--shadow-md);
        }

        /* Decorative accent frame behind image */
        .about__image::before {
            content: '';
            position: absolute;
            top: -20px;
            left: -20px;
            right: 20px;
            bottom: 20px;
            border: 2px solid var(--color-sage);
            border-radius: 16px;
            opacity: 0.3;
            z-index: -1;
        }

        .about__text {
            font-size: 1.05rem;
            color: var(--color-text-light);
            line-height: 1.8;
            margin-bottom: 20px;
        }

        .about__signature {
            margin-top: 32px;
            padding-top: 32px;
            border-top: 1px solid var(--color-border);
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .about__signature-avatar {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--color-sage-light), var(--color-sage));
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-white);
            font-family: var(--font-serif);
            font-size: 1.3rem;
        }

        .about__signature-name {
            font-family: var(--font-serif);
            font-size: 1.1rem;
            color: var(--color-charcoal);
            margin-bottom: 2px;
        }

        .about__signature-role {
            font-size: 0.85rem;
            color: var(--color-text-light);
        }

        /* ============================================
           FEATURES / BENEFITS SECTION
           Grid of cards with icons
           ============================================ */
        .features__grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 32px;
        }

        .feature-card {
            padding: 40px 32px;
            background-color: var(--color-white);
            border-radius: 16px;
            border: 1px solid var(--color-border);
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        /* Hover: lift up with shadow */
        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
            border-color: transparent;
        }

        /* Decorative corner accent on hover */
        .feature-card::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 80px;
            height: 80px;
            background: radial-gradient(circle at top right, rgba(139, 158, 130, 0.15), transparent 70%);
            opacity: 0;
            transition: var(--transition);
        }

        .feature-card:hover::after {
            opacity: 1;
        }

        .feature-card__icon {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            background-color: rgba(139, 158, 130, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 24px;
            color: var(--color-sage-dark);
            transition: var(--transition);
        }

        .feature-card:hover .feature-card__icon {
            background-color: var(--color-sage);
            color: var(--color-white);
            transform: rotate(-5deg) scale(1.05);
        }

        .feature-card__title {
            font-family: var(--font-serif);
            font-size: 1.4rem;
            font-weight: 500;
            color: var(--color-charcoal);
            margin-bottom: 12px;
        }

        .feature-card__text {
            font-size: 0.95rem;
            color: var(--color-text-light);
            line-height: 1.7;
        }

        /* ============================================
           CLASSES PREVIEW SECTION
           Horizontal cards showing class types
           ============================================ */
        .classes {
            background-color: var(--color-white);
        }

        .classes__grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 28px;
        }

        .class-card {
            border-radius: 16px;
            overflow: hidden;
            background-color: var(--color-cream);
            transition: var(--transition);
            cursor: pointer;
        }

        .class-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md);
        }

        .class-card__image {
            aspect-ratio: 4 / 3;
            background: linear-gradient(135deg, #E8E0D4, #D4C9BC);
            position: relative;
            overflow: hidden;
        }

        .class-card__image svg {
            width: 100%;
            height: 100%;
        }

        .class-card__content {
            padding: 28px;
        }

        .class-card__title {
            font-family: var(--font-serif);
            font-size: 1.4rem;
            color: var(--color-charcoal);
            margin-bottom: 10px;
        }

        .class-card__text {
            font-size: 0.92rem;
            color: var(--color-text-light);
            line-height: 1.6;
            margin-bottom: 18px;
        }

        .class-card__meta {
            display: flex;
            gap: 12px;
            font-size: 0.78rem;
            font-weight: 500;
            color: var(--color-sage-dark);
            letter-spacing: 0.5px;
        }

        .class-card__meta span {
            padding: 5px 14px;
            background-color: rgba(139, 158, 130, 0.12);
            border-radius: 20px;
        }

        /* ============================================
           CTA BANNER
           Full-width sage-colored call-to-action
           ============================================ */
        .cta-banner {
            background: linear-gradient(135deg, var(--color-sage) 0%, var(--color-sage-dark) 100%);
            padding: 90px 0;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        /* Decorative circles */
        .cta-banner::before,
        .cta-banner::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
        }

        .cta-banner::before {
            width: 300px;
            height: 300px;
            top: -100px;
            left: -100px;
        }

        .cta-banner::after {
            width: 400px;
            height: 400px;
            bottom: -150px;
            right: -150px;
        }

        .cta-banner__content {
            position: relative;
            z-index: 1;
        }

        .cta-banner__title {
            font-family: var(--font-serif);
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            font-weight: 400;
            color: var(--color-white);
            margin-bottom: 16px;
            line-height: 1.2;
        }

        .cta-banner__text {
            font-size: 1.05rem;
            color: rgba(255, 255, 255, 0.85);
            margin-bottom: 36px;
            max-width: 520px;
            margin-left: auto;
            margin-right: auto;
        }

        .cta-banner .btn--primary {
            background-color: var(--color-white);
            color: var(--color-sage-dark);
            border-color: var(--color-white);
        }

        .cta-banner .btn--primary:hover {
            background-color: var(--color-cream);
            border-color: var(--color-cream);
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
        }

        /* ============================================
           CONTACT SECTION
           Two-column: info + form
           ============================================ */
        .contact__grid {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 60px;
            align-items: start;
        }

        .contact__info-item {
            margin-bottom: 32px;
        }

        .contact__info-title {
            font-family: var(--font-serif);
            font-size: 1.25rem;
            color: var(--color-charcoal);
            margin-bottom: 8px;
        }

        .contact__info-text {
            font-size: 0.95rem;
            color: var(--color-text-light);
            line-height: 1.8;
        }

        .contact__socials {
            display: flex;
            gap: 12px;
            margin-top: 32px;
        }

        .contact__social {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: 1.5px solid var(--color-border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-text);
            transition: var(--transition);
        }

        .contact__social:hover {
            border-color: var(--color-sage);
            color: var(--color-sage);
            background-color: rgba(139, 158, 130, 0.08);
            transform: translateY(-3px);
        }

        /* Contact form styling */
        .contact__form {
            background-color: var(--color-white);
            padding: 44px;
            border-radius: 20px;
            box-shadow: var(--shadow-md);
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-label {
            display: block;
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--color-charcoal);
            margin-bottom: 8px;
        }

        .form-input {
            width: 100%;
            padding: 14px 18px;
            font-family: var(--font-sans);
            font-size: 0.95rem;
            border: 1.5px solid var(--color-border);
            border-radius: 10px;
            background-color: var(--color-cream);
            color: var(--color-text);
            transition: var(--transition);
            outline: none;
        }

        .form-input:focus {
            border-color: var(--color-sage);
            background-color: var(--color-white);
            box-shadow: 0 0 0 4px rgba(139, 158, 130, 0.1);
        }

        .form-textarea {
            resize: vertical;
            min-height: 120px;
            font-family: var(--font-sans);
        }

        /* ============================================
           FOOTER
           Dark background with brand, links, copyright
           ============================================ */
        .footer {
            background-color: var(--color-charcoal);
            color: rgba(255, 255, 255, 0.7);
            padding: 70px 0 0;
        }

        .footer__container {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 60px;
            padding-bottom: 50px;
        }

        .footer .header__logo-text {
            color: var(--color-white);
        }

        .footer .header__logo-sub {
            color: var(--color-sage-light);
        }

        .footer__tagline {
            margin-top: 16px;
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.5);
            max-width: 300px;
            line-height: 1.6;
        }

        .footer__col-title {
            font-family: var(--font-sans);
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--color-white);
            margin-bottom: 22px;
        }

        .footer__col ul li {
            margin-bottom: 12px;
        }

        .footer__col ul li a {
            font-size: 0.92rem;
            color: rgba(255, 255, 255, 0.6);
        }

        .footer__col ul li a:hover {
            color: var(--color-sage-light);
        }

        .footer__bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding: 22px 0;
            text-align: center;
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.4);
        }

        /* ============================================
           RESPONSIVE DESIGN
           Tablet breakpoint (1024px)
           ============================================ */
        @media (max-width: 1024px) {
            :root {
                --section-padding: 90px;
            }

            .hero__illustration {
                width: 40%;
                right: 2%;
                opacity: 0.6;
            }

            .about__container {
                gap: 50px;
            }

            .contact__grid {
                gap: 40px;
            }

            .footer__container {
                gap: 40px;
            }
        }

        /* ============================================
           RESPONSIVE DESIGN
           Mobile breakpoint (768px)
           ============================================ */
        @media (max-width: 768px) {
            :root {
                --section-padding: 70px;
            }

            /* Mobile navigation - CSS-only toggle */
            .nav__burger {
                display: flex;
            }

            .header__cta {
                display: none;
            }

            .nav {
                position: fixed;
                top: 0;
                right: -100%;
                width: 75%;
                max-width: 320px;
                height: 100vh;
                background-color: var(--color-cream);
                padding: 110px 40px 40px;
                transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
                box-shadow: -10px 0 40px rgba(0, 0, 0, 0.1);
            }

            /* Checkbox hack: show nav when checked */
            .nav__toggle:checked ~ .nav {
                right: 0;
            }

            /* Animate burger to X when active */
            .nav__toggle:checked ~ .nav__burger span:nth-child(1) {
                transform: rotate(45deg) translate(5px, 5px);
            }
            .nav__toggle:checked ~ .nav__burger span:nth-child(2) {
                opacity: 0;
            }
            .nav__toggle:checked ~ .nav__burger span:nth-child(3) {
                transform: rotate(-45deg) translate(5px, -5px);
            }

            .nav__list {
                flex-direction: column;
                gap: 28px;
            }

            .nav__link {
                font-size: 1.1rem;
            }

            /* Hero adjustments */
            .hero {
                padding-top: 120px;
                padding-bottom: 60px;
            }

            .hero__illustration {
                display: none;
            }

            .hero__content {
                max-width: 100%;
                text-align: left;
            }

            .hero__stats {
                gap: 24px;
                flex-wrap: wrap;
            }

            .hero__actions {
                flex-direction: column;
                align-items: stretch;
            }

            .hero__actions .btn {
                text-align: center;
            }

            /* About: stack vertically */
            .about__container {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .about__image {
                max-width: 400px;
                margin: 0 auto;
            }

            .about__image::before {
                display: none;
            }

            /* Contact: stack vertically */
            .contact__grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .contact__form {
                padding: 32px 24px;
            }

            /* Footer: stack columns */
            .footer__container {
                grid-template-columns: 1fr 1fr;
                gap: 40px;
            }

            .footer__brand {
                grid-column: 1 / -1;
            }
        }

        /* ============================================
           RESPONSIVE DESIGN
           Small mobile breakpoint (480px)
           ============================================ */
        @media (max-width: 480px) {
            :root {
                --section-padding: 56px;
            }

            .container {
                padding: 0 20px;
            }

            .hero__stats {
                flex-direction: column;
                gap: 20px;
                align-items: flex-start;
            }

            .features__grid {
                grid-template-columns: 1fr;
            }

            .classes__grid {
                grid-template-columns: 1fr;
            }

            .footer__container {
                grid-template-columns: 1fr;
            }

            .cta-banner {
                padding: 70px 0;
            }
        }
    </style>
</head>
<body>

